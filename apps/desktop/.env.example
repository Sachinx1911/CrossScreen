# The desktop app is not served by Vite, so it always needs an explicit URL.
#
# Local development:
VITE_SIGNALING_URL=ws://127.0.0.1:8787
#
# Cross-network test: point it at the tunnel, keeping the /ws path.
# VITE_SIGNALING_URL=wss://your-tunnel.trycloudflare.com/ws

# TURN credentials, needed only for Phase 0.5 exit criterion 4 (forced relay).
# DISCLOSED SHORTCUT: build-time credentials are replaced in Phase 2 by
# GET /api/v1/ice-servers issuing short-lived ones (ADR-0004).
# VITE_TURN_URLS=turn:turn.cloudflare.com:3478?transport=udp,turns:turn.cloudflare.com:5349?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Set to 1 to pin ICE to relay only, proving the TURN path independently of P2P.
# VITE_FORCE_RELAY=1
