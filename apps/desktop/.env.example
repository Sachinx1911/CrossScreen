# The desktop app is not served by Vite, so it always needs an explicit URL.
#
# Local development:
VITE_SIGNALING_URL=ws://127.0.0.1:8787
#
# Cross-network test: point it at the tunnel, keeping the /ws path.
# VITE_SIGNALING_URL=wss://your-tunnel.trycloudflare.com/ws

# TURN is NOT configured here. This app asks GET /api/v1/ice-servers for it,
# so the credentials live in services/api/.env.local and `pnpm turn` writes
# them there — no client ever ships one (ADR-0004).

# Set to 1 to pin ICE to relay only, proving the TURN path independently of
# P2P. A build-time flag here rather than the browser's ?relay=1, because this
# window is never reached by navigating to a fresh URL. Restart after changing
# it. Both sharing and joining refuse to start, saying so, if the API hands
# back no TURN server.
# VITE_FORCE_RELAY=1
