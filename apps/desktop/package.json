{
  "name": "@crossscreen/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CrossScreen desktop sharer (Electron)",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.main.json && vite build",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc -b tsconfig.main.json --noEmit false --emitDeclarationOnly && tsc -p tsconfig.json --noEmit",
    "verify:capture": "electron scripts/verify-capture.mjs",
    "verify:renderer": "electron scripts/verify-renderer.mjs"
  },
  "dependencies": {
    "@crossscreen/protocol": "workspace:*",
    "@crossscreen/webrtc-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^44.2.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
