{
  "name": "@crossscreen/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CrossScreen web viewer",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@crossscreen/capture": "workspace:*",
    "@crossscreen/protocol": "workspace:*",
    "@crossscreen/webrtc-core": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
