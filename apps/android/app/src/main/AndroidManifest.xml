<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Four permissions, all earned by ScreenShareService existing now
      (capture/ScreenShareService.kt):
        FOREGROUND_SERVICE / FOREGROUND_SERVICE_MEDIA_PROJECTION — the
          Android 14+ requirement this app has been anxious about since the
          walking skeleton: a foreground service of type mediaProjection is
          mandatory before MediaProjectionManager.getMediaProjection() may
          be called, and FOREGROUND_SERVICE_MEDIA_PROJECTION specifically is
          what Android 14 added on top of the older, general permission.
        POST_NOTIFICATIONS — Android 13+ requires runtime consent for any
          notification, including a foreground service's; requested at the
          point of use (MainActivity), not assumed.
      None of these are declared "just in case" — MediaProjection's own
      consent is still requested at runtime through its own system dialog,
      not through a manifest permission at all.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      The signaling/API client (net/) needs the network. WebRTC media is
      peer-to-peer and would want it regardless; this is also what the
      HTTP session-create call and the signaling WebSocket use.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.CrossScreen">

        <!--
          Exported: this is the only entry point today and it launches from
          the home screen, which is exactly what android:exported="true"
          is for — not a default left unexamined.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not exported: only this app ever starts it, over a plain Intent
          from MainActivity, never from outside the process.
          foregroundServiceType="mediaProjection" is what the OS checks
          startForeground()'s type argument against — a mismatch here is a
          crash, not a warning.
        -->
        <service
            android:name=".capture.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>
