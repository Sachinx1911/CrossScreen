{
  "name": "@crossscreen/webrtc-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared WebRTC peer setup, screen-share tuning and connection stats",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@crossscreen/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
