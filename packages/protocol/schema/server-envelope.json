{
  "$id": "https://crossscreen.app/schema/server-envelope.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ts": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.state"
            },
            "session": {
              "type": "object",
              "properties": {
                "joinCode": {
                  "type": "string",
                  "pattern": "^\\d{6}$"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "waiting",
                    "active",
                    "ended",
                    "expired"
                  ]
                },
                "createdAt": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "expiresAt": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "participants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "participantId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "role": {
                        "type": "string",
                        "enum": [
                          "host",
                          "viewer"
                        ]
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "pending",
                          "approved",
                          "rejected",
                          "connected",
                          "disconnected"
                        ]
                      },
                      "deviceLabel": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "joinedAt": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "participantId",
                      "role",
                      "state",
                      "deviceLabel"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "joinCode",
                "state",
                "createdAt",
                "expiresAt",
                "participants"
              ],
              "additionalProperties": false
            },
            "you": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "type",
            "session",
            "you"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.viewer.pending"
            },
            "request": {
              "type": "object",
              "properties": {
                "participantId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "deviceLabel": {
                  "type": "string",
                  "maxLength": 64
                },
                "approximateLocation": {
                  "type": "string",
                  "maxLength": 96
                },
                "joinedVia": {
                  "type": "string",
                  "enum": [
                    "code",
                    "link"
                  ]
                },
                "requestedAt": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "participantId",
                "deviceLabel",
                "joinedVia",
                "requestedAt"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "request"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.viewer.approved"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "participantToken": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "participantId",
            "participantToken"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.viewer.rejected"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "peer.joined"
            },
            "participant": {
              "type": "object",
              "properties": {
                "participantId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "host",
                    "viewer"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "approved",
                    "rejected",
                    "connected",
                    "disconnected"
                  ]
                },
                "deviceLabel": {
                  "type": "string",
                  "maxLength": 64
                },
                "joinedAt": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "participantId",
                "role",
                "state",
                "deviceLabel"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "participant"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "peer.left"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "type",
            "participantId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.ended"
            },
            "reason": {
              "type": "string",
              "enum": [
                "host_ended",
                "expired",
                "idle_timeout"
              ]
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.offer"
            },
            "from": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sdp": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "from",
            "sdp"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.answer"
            },
            "from": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sdp": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "from",
            "sdp"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.ice"
            },
            "from": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "candidate": {
              "type": "string"
            },
            "sdpMid": {
              "type": [
                "string",
                "null"
              ]
            },
            "sdpMLineIndex": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "from",
            "candidate",
            "sdpMid",
            "sdpMLineIndex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.restart"
            },
            "from": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "type",
            "from"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "enum": [
                "SESSION_NOT_FOUND",
                "SESSION_EXPIRED",
                "SESSION_ENDED_BY_HOST",
                "SESSION_FULL",
                "SESSION_LOCKED",
                "JOIN_REJECTED",
                "JOIN_REQUEST_TIMED_OUT",
                "INVALID_TOKEN",
                "TOKEN_EXPIRED",
                "NOT_SESSION_HOST",
                "RATE_LIMITED",
                "TOO_MANY_SESSIONS",
                "CONNECTION_FAILED",
                "CONNECTION_LOST",
                "SIGNALING_UNAVAILABLE",
                "CAPTURE_PERMISSION_DENIED",
                "CAPTURE_UNAVAILABLE",
                "CAPTURE_STOPPED_BY_SYSTEM",
                "MALFORMED_MESSAGE",
                "UNSUPPORTED_PROTOCOL_VERSION",
                "MESSAGE_TOO_LARGE",
                "INTERNAL_ERROR"
              ]
            },
            "userMessage": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "inReplyTo": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "code",
            "userMessage",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pong"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
