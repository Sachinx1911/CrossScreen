{
  "$id": "https://crossscreen.app/schema/client-envelope.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "ts": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.host.attach"
            },
            "hostToken": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "hostToken"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.viewer.request"
            },
            "joinCode": {
              "type": "string",
              "pattern": "^\\d{6}$"
            },
            "joinToken": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22}$"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.viewer.approve"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "type",
            "participantId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.viewer.reject"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "type",
            "participantId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session.end"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.offer"
            },
            "to": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sdp": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "to",
            "sdp"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.answer"
            },
            "to": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "sdp": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "to",
            "sdp"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.ice"
            },
            "to": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "candidate": {
              "type": "string"
            },
            "sdpMid": {
              "type": [
                "string",
                "null"
              ]
            },
            "sdpMLineIndex": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "to",
            "candidate",
            "sdpMid",
            "sdpMLineIndex"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "rtc.restart"
            },
            "to": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "type",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stats.report"
            },
            "quality": {
              "type": "string",
              "enum": [
                "excellent",
                "good",
                "poor",
                "unstable"
              ]
            },
            "connectionState": {
              "type": "string",
              "enum": [
                "connecting",
                "checking",
                "securing",
                "connected",
                "unstable",
                "reconnecting",
                "failed"
              ]
            },
            "transport": {
              "type": "string",
              "enum": [
                "direct",
                "relay",
                "unknown"
              ]
            },
            "roundTripMs": {
              "type": "number",
              "minimum": 0
            },
            "packetLossPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "bitrateKbps": {
              "type": "number",
              "minimum": 0
            },
            "framesPerSecond": {
              "type": "number",
              "minimum": 0
            },
            "resolution": {
              "type": "string",
              "maxLength": 16
            },
            "codec": {
              "type": "string",
              "maxLength": 24
            }
          },
          "required": [
            "type",
            "quality",
            "connectionState",
            "transport"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ping"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "v",
    "id",
    "ts",
    "payload"
  ],
  "additionalProperties": false
}
