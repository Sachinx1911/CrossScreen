{
  "$id": "https://crossscreen.app/schema/join-request-info.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "participantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "deviceLabel": {
      "type": "string",
      "maxLength": 64
    },
    "approximateLocation": {
      "type": "string",
      "maxLength": 96
    },
    "joinedVia": {
      "type": "string",
      "enum": [
        "code",
        "link"
      ]
    },
    "requestedAt": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "participantId",
    "deviceLabel",
    "joinedVia",
    "requestedAt"
  ],
  "additionalProperties": false
}
