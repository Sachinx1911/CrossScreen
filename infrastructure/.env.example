# Copy to infrastructure/.env and fill in before running docker-compose.prod.yml.
# Never commit the real file — .gitignore already refuses .env*.

# The domain ADR-0010 has not resolved yet (crossscreen.app's availability
# and trademark status are both unchecked). Three subdomains are used —
# app.<DOMAIN>, api.<DOMAIN>, signal.<DOMAIN> — set up as A records pointing
# at this VPS before running certbot.
DOMAIN=example.com

# Required, no default — the same rule config.ts enforces at startup.
#   openssl rand -base64 32
SESSION_SECRET=

# Required, no default. Chosen by you, not generated: this is what
# DATABASE_URL is built from below, in this file only — postgres.js reads a
# connection string, not this variable directly.
POSTGRES_PASSWORD=

# Optional. Without it, /api/v1/ice-servers serves STUN-only — see
# dev-setup.md for the one-time dashboard setup that produces these.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional. Without it, errors are logged but not reported
# (phase-2-reliability.md §2.6).
SENTRY_DSN=
