# Required. Verifies host tokens, and must be IDENTICAL to the API service's —
# the two share a secret instead of a database (ADR-0011). There is deliberately
# no development default: one would work locally, survive review, and arrive in
# production as a publicly known signing key.
#
#   openssl rand -base64 32
#
SESSION_SECRET=

# Optional
# SIGNALING_PORT=8787
# SIGNALING_HOST=127.0.0.1
# LOG_LEVEL=info
