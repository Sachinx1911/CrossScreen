# Required. Signs host tokens, and must be identical in the signaling service
# (ADR-0011). There is deliberately no development default: one would work
# locally, survive review, and reach production as a publicly known signing key.
#
#   openssl rand -base64 32
#
SESSION_SECRET=

# Optional
# API_PORT=8788
# API_HOST=127.0.0.1
# APP_ORIGIN=http://localhost:5173

# ICE configuration handed to clients. Phase 2 replaces this endpoint with
# short-lived Cloudflare credentials (ADR-0004).
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=
# TURN_USERNAME=
# TURN_CREDENTIAL=
