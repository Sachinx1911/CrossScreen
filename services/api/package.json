{
  "name": "@crossscreen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Session lifecycle and configuration API",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --watch src/server.ts",
    "start": "node --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@crossscreen/db": "workspace:*",
    "@crossscreen/logging": "workspace:*",
    "@crossscreen/protocol": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
